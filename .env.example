# Online Reset local configuration. Copy to .env AND apps/web/.env.
# Never commit real values. All providers default to labelled fixtures.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/elmo
DEPLOYMENT_MODE=local
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME="Online Reset"
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
ELMO_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
DISABLE_TELEMETRY=1

# Collection targets: model:provider[:version][:online]. Fixture targets need no keys
# and are stored as collection_method=fixture (never shown as live results).
SCRAPE_TARGETS=stub:stub
ONBOARDING_LLM_TARGET=stub:stub
TYPESAFE_API_KEY=stub

# Paid providers — leave empty until spend is approved.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Local only, free: Ollama OpenAI-compatible endpoint for embeddings/drafting in dev.
OLLAMA_BASE_URL=http://localhost:11434/v1
